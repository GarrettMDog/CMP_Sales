{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.17/MicrosoftTeams.schema.json",
  "manifestVersion": "1.17",
  "version": "1.0.0",
  "id": "3f0ff8bc-9197-428b-9d2f-88f84684f718",
  "developer": {
    "name": "Your Company",
    "websiteUrl": "https://cmp-sales.vercel.app",
    "privacyUrl": "https://cmp-sales.vercel.app/privacy",
    "termsOfUseUrl": "https://cmp-sales.vercel.app/terms"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "name": {
    "short": "Relationship CRM",
    "full": "Relationship CRM for Sales"
  },
  "description": {
    "short": "Track relationships, not just deals.",
    "full": "A shared relationship tracker for the sales team: log every touchpoint, see who last spoke to a contact, and get reminded — automatically routed to whoever spoke to them most recently — before a relationship goes cold. Includes birthday tracking so no one misses a beat."
  },
  "accentColor": "#5B5FC7",
  "staticTabs": [
    {
      "entityId": "relationshipCrmHome",
      "name": "Contacts",
      "contentUrl": "https://cmp-sales.vercel.app/",
      "websiteUrl": "https://cmp-sales.vercel.app/",
      "scopes": ["personal"]
    }
  ],
  "configurableTabs": [
    {
      "configurationUrl": "https://cmp-sales.vercel.app/config.html",
      "canUpdateConfiguration": true,
      "scopes": ["team", "groupChat"]
    }
  ],
  "permissions": ["identity", "messageTeamMembers"],
  "validDomains": ["cmp-sales.vercel.app"]
}
